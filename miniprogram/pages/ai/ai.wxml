<view class="container">

<view class="title">
  🤖 小饭AI推荐
</view>


<scroll-view 
  class="chat-box"
  scroll-y="true"
  scroll-with-animation="true"
  scroll-into-view="{{scrollIntoView}}">

  <view 
    wx:for="{{messages}}"
    wx:key="index"
    id="message-{{index}}"
    class="{{item.role}}">

    {{item.content}}

    <view wx:if="{{item.feedbackFoodName}}" class="feedback-actions">
      <button
        class="feedback-button"
        data-food-name="{{item.feedbackFoodName}}"
        bindtap="likeRecommendation">
        👍喜欢
      </button>
      <button
        class="feedback-button"
        data-food-name="{{item.feedbackFoodName}}"
        bindtap="dislikeRecommendation">
        👎不喜欢
      </button>
    </view>

  </view>

</scroll-view>


<input
  class="input-box"
  placeholder="告诉我：预算、口味、心情都可以"
  value="{{inputText}}"
  bindinput="inputChange"
/>


<button 
  disabled="{{isLoading}}"
  bindtap="sendMessage">
  ✨ AI推荐
</button>

<button 
 disabled="{{isLoading}}"
 bindtap="changeFood">
 🔄 换一个
</button>

<button
 disabled="{{isLoading}}"
 bindtap="showRecentRecommendations">
 📋 查看最近推荐
</button>


</view>
