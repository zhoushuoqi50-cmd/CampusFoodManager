<view class="container">

<view class="title">
  🤖 小饭AI推荐
</view>


<scroll-view 
  class="chat-box"
  scroll-y="true">

  <view 
    wx:for="{{messages}}"
    wx:key="index"
    class="{{item.role}}">

    {{item.content}}

  </view>

</scroll-view>


<input
  class="input-box"
  placeholder="告诉我：预算、口味、心情都可以"
  bindinput="inputChange"
/>


<button 
  bindtap="sendMessage">
  ✨ AI推荐
</button>


</view>